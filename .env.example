# This file contains examples only. Copy it to .env and restrict it with chmod 600 .env.
# Pass --credential-file .env explicitly; open-agent does not auto-discover dotenv files.
# Leave optional values empty. Never commit a filled-in .env or put secrets in CLI arguments.

# Driver and option selection. Each value answers the matching create/setup question; the flag
# named in each comment overrides it, and interactive runs ask only when neither is set.
# Precedence: flag > this file > process environment > prompt > default.

# Workstation provider (--provider). Registered providers: fly-machine, sprite (default). Fixed after creation.
OPEN_AGENT_PROVIDER=

# ACP agent served on the workstation (--agent). Registered agents: t3. Fixed after creation.
OPEN_AGENT_AGENT=

# Release channel of the ACP agent (--release). Registered for t3: stable (default), nightly. Changed later with `setup --section agent` or `--section all`.
OPEN_AGENT_RELEASE=

# Minimum CPUs (--cpu) and minimum memory in GB (--mem), whole numbers from 1. Default 2 and 2.
# The provider runs the smallest machine it offers that meets both; create refuses a size it cannot meet.
# On a live workstation, setup resizes only when one is set; a Fly Machine restarts to resize and needs --yes
# or an interactive confirmation.
OPEN_AGENT_CPU=
OPEN_AGENT_MEM=

# Comma-separated harnesses the agent drives (repeatable --harness). Registered: claude, codex.
OPEN_AGENT_HARNESSES=

# Private network (--network): none or tailscale. none keeps the workstation off any private network.
# Non-interactive creation infers tailscale from supplied Tailscale inputs when unset.
OPEN_AGENT_NETWORK=

# Suspend after this many idle minutes (--idle-minutes); 0 never suspends. Default 5.
# Asked only when the provider keeps workstations awake.
OPEN_AGENT_IDLE_MINUTES=

# Turn-hold lifetime in minutes after its last refresh (--hold-max-minutes). Default 60. Never prompted.
OPEN_AGENT_HOLD_MAX_MINUTES=

# Days after the last successful update before another is due (--update-due-days), 1 to 365. Default 1. Never prompted.
OPEN_AGENT_UPDATE_DUE_DAYS=

# Route egress through an exit node on the selected network (true/false, 1/0, yes/no, on/off).
# --use-exit-node / --no-use-exit-node overrides this value. Asked only when the network supports exit nodes.
# When unset, non-interactive creation infers from the exit-node identity below.
OPEN_AGENT_USE_EXIT_NODE=

# Provider credentials. Each is needed only by its own provider; --provider-token-source selects another source
# for the selected provider. create reads only the selected provider's token; list reads every provider's token,
# and other commands read every provider's token to find the workstation unless --provider or
# --provider-token-source is given. Tokens are used locally for authenticated provider operations; never uploaded.

# Optional Fly Sprites organization token, the sprite provider's credential. A Fly API token (FlyV1 ..., fm2_...,
# fo1_...) is refused offline before any provider call; any other value is sent to the provider, and one it rejects
# fails with AUTH and is never saved.
# Get one at https://sprites.dev/account: sign in with Fly and select the organization that owns the workstations.
SPRITES_TOKEN=

# Optional Fly organization token, the fly-machine provider's credential. A token derived from it in memory opens
# SSH sessions; neither reaches the workstation. It must be able to create apps, machines and volumes; the
# organization it names owns the workstations. Create one with `fly tokens create org -o <organization>`.
# A Sprites token is refused by its shape; flyctl then decodes the rest offline before any provider call and
# refuses deploy, SSH and personal login tokens and expired tokens.
FLY_API_TOKEN=

# Tailscale management API key (--network-key-source selects another source). Kept locally to enroll
# devices and clean up deleted workstation devices. Read only when the selected network is tailscale.
# An explicit auth key below can enrol a device without this key; device deletion still needs authorisation.
# Required for authorised tailnet-device deletion during the full live verification.
TAILSCALE_API_KEY=

# Tailscale Tailnet ID, full DNS domain (for example yak-bebop.ts.net), or bare DNS subdomain (yak-bebop).
# Used by local Tailscale API operations. The exact value is tried first in a read-only device query.
# If a bare DNS subdomain returns 404, open-agent retries with .ts.net appended and verifies it
# before enrolment. Existing API IDs and full domains are preserved; no other tailnet is selected.
# Find the DNS domain at https://login.tailscale.com/admin/dns or the Tailnet ID in General settings.
# Required when the network is tailscale (--network-account). Private proxy access is checked after joining.
TAILSCALE_TAILNET=

# Optional short-lived, single-use Tailscale device enrolment key (--network-auth-key-source).
# Sent only for enrolment, then discarded.
TAILSCALE_AUTH_KEY=

# Existing approved exit-node hostname, device ID, or Tailscale IP (--exit-node). Required only with exit-node routing.
# Short machine names are supported without the tailnet domain and compared case-insensitively.
# The name must match exactly one device with approved IPv4 exit routes; advertising alone is insufficient.
# Enable Use as exit node in the Tailscale machines administration page and allow access in tailnet policy.
# Tailscale may instead be enabled solely for private tailnet access without an exit node.
TAILSCALE_EXIT_NODE=

# Enable or disable direct CLIProxyAPI routing for every selected harness (same boolean syntax).
# --proxy / --no-proxy overrides this value. Asked only when a selected harness supports the proxy.
# Non-interactive creation infers enablement from supplied proxy inputs when unset.
# Setup preserves the installed choice unless explicitly changed or the proxy section is selected.
# Disabled means native harness sign-in/configuration; no managed calls to the proxy.
CLIPROXYAPI_ENABLED=

# Existing CLIProxyAPI hub URL, for example https://proxy.example.com or its /v1 API base.
# Claude uses the hub root; Codex uses /v1 and /v1/models. A trailing /v1 is normalized once.
# Required when proxy routing is enabled. A private tailnet endpoint also needs Tailscale connectivity.
CLIPROXYAPI_BASE_URL=

# Hub client credential for Claude/Codex. This is not the hub administration or upstream provider key.
# Required when proxy routing is enabled; stored directly in protected native guest configuration.
CLIPROXYAPI_API_KEY=

# Optional GitHub credential. GH_TOKEN takes precedence over GITHUB_TOKEN within the same input source.
# Without a configured token, allowed local gh discovery may supply a default; GitHub access can be skipped.
GH_TOKEN=

# Optional alternative GitHub credential when GH_TOKEN is unset.
GITHUB_TOKEN=

# Optional explicit Git/Jujutsu author name. Identity is resolved independently of GitHub authentication.
GIT_AUTHOR_NAME=

# Optional explicit author email. The selected email is visible in commits.
GIT_AUTHOR_EMAIL=

# Optional separate committer name. Preserves deliberately different author and committer identities.
GIT_COMMITTER_NAME=

# Optional separate committer email. Does not silently replace an explicit author email.
GIT_COMMITTER_EMAIL=

# Interaction variables below are read from process environment and the explicitly selected dotenv file.
# Process environment takes precedence; CLI switches and unavailable TTY capabilities also govern mode.

# Disable interactive input when 1, true, yes or on (case-insensitive).
# Values 0, false, no and off are false; --json/--non-interactive and unavailable TTYs also disable prompts.
NON_INTERACTIVE=

# Standard automation marker, using the same truthy/falsey rules as NON_INTERACTIVE.
CI=

# Terminal capability marker. TERM=dumb disables interactive input; normally supplied by your terminal.
# Leave this commented out in dotenv files unless you explicitly need an override.
# TERM=

# Standard no-colour marker. A nonempty value removes colour but does not itself disable interaction.
NO_COLOR=

# Optional OS configuration root for the local protected-file credential fallback.
# Read from the invoking process environment only; do not set this in the credential file.
# Unset uses ~/.config. Keep this commented out to preserve your machine's existing choice.
# XDG_CONFIG_HOME=

# Optional Wayland display name used only to choose the local interactive clipboard tool.
# Supplied by the desktop session; do not set it in the credential file.
# WAYLAND_DISPLAY=

# Nothing in this file reaches the workstation. Put variables for the agent and its shells in a
# separate dotenv file passed with --env-file on create or setup; there HOME, PATH, native
# configuration roots, provider overrides, proxy settings, credentials, OA_* names and process
# injection variables are rejected to protect managed routing/configuration.
